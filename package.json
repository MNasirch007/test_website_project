{
  "name": "renter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "wrangler dev --config dist/server/wrangler.json --local",
    "test": "node --test tests/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply renter-local --local",
    "test:e2e": "playwright test",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
